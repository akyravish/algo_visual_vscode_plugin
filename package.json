{
  "name": "algo-visual",
  "displayName": "Algo Visual",
  "description": "Watch your JavaScript run \u2014 arrays, maps, objects, trees and every variable, animated step by step beside your code",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node test.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "algoVisual.show",
        "title": "Algo Visual: Show",
        "icon": "$(pulse)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "algoVisual.show",
          "when": "editorLangId == javascript",
          "group": "navigation"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/akyravish/algo_visual_vscode_plugin.git"
  }
}